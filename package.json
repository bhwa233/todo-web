{
  "name": "todo-web",
  "version": "2.0.0",
  "packageManager": "pnpm@11.1.0",
  "private": true,
  "author": "",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "typescript"
  ],
  "scripts": {
    "dev": "vinext dev --port 3012",
    "build": "pnpm data:generate && vinext build",
    "start": "vinext start",
    "type-check": " tsc --noEmit",
    "lint": "eslint .",
    "format": " prettier --ignore-path .gitignore \"src/**/*.+(ts|js|tsx)\" --write",
    "migrate": "pnpm data:migrate:local",
    "test": "vitest",
    "data:dev": "pnpm data:generate && wrangler dev --config data-service/wrangler.jsonc",
    "data:types": "wrangler types --config data-service/wrangler.jsonc data-service/worker-configuration.d.ts --strict-vars=false --env-interface TodoDataEnv",
    "data:check": "pnpm data:types && tsc --project data-service/tsconfig.json",
    "data:build": "pnpm data:generate && wrangler deploy --config data-service/wrangler.jsonc --dry-run",
    "data:deploy": "wrangler deploy --config data-service/wrangler.jsonc",
    "data:migrate:local": "wrangler d1 migrations apply DB --local --config data-service/wrangler.jsonc",
    "data:migrate:remote": "wrangler d1 migrations apply DB --remote --config data-service/wrangler.jsonc",
    "data:export": "node --experimental-strip-types scripts/d1/export.mjs",
    "data:verify": "node --experimental-strip-types scripts/d1/verify.mjs",
    "data:import": "node --experimental-strip-types scripts/d1/import.mjs",
    "data:generate": "prisma generate && node scripts/d1/generate-metadata.mjs",
    "cf:types": "wrangler types worker-configuration.d.ts --strict-vars=false --env-interface TodoWebEnv",
    "preview": "vite preview --port 3012",
    "cf:check": "pnpm cf:types && pnpm type-check",
    "cf:deploy:preview": "wrangler deploy --config dist/server/wrangler.json",
    "cf:deploy:production": "wrangler deploy --config dist/server/wrangler.json",
    "build:production": "pnpm data:generate && cross-env CLOUDFLARE_ENV=production vinext build",
    "data:deploy:production": "pnpm data:migrate:production && wrangler deploy --config data-service/wrangler.jsonc --env production",
    "data:migrate:production": "wrangler d1 migrations apply DB --remote --config data-service/wrangler.jsonc --env production"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@mui/lab": "7.0.0-beta.12",
    "@mui/material": "^7.3.9",
    "@mui/material-nextjs": "^7.3.9",
    "@prisma/adapter-d1": "6.19.2",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "ahooks": "^3.9.7",
    "axios": "^1.18.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dayjs": "^1.11.20",
    "decimal.js": "^10.6.0",
    "htmlparser2": "12.0.0",
    "immer": "^10.2.0",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.13",
    "lucide-react": "^0.475.0",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "19.3.1",
    "react-infinite-scroll-component": "^6.1.1",
    "react-markdown": "^9.1.0",
    "react-photo-view": "^1.2.7",
    "react-server-dom-webpack": "19.3.1",
    "recharts": "^2.15.4",
    "remark-gfm": "4.0.1",
    "sharp": "^0.35.0",
    "superjson": "2.2.6",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "use-count-up": "^3.0.1",
    "use-immer": "^0.11.0",
    "vaul": "^1.1.2",
    "vitest": "^3.2.6",
    "zod": "4.3.6",
    "zustand": "^5.0.12",
    "zustand-middleware-computed": "^1.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@prisma/internals": "6.19.2",
    "@serwist/vite": "9.5.13",
    "@serwist/window": "9.5.13",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.19.15",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "pg": "^8.23.1",
    "postcss": "^8.5.12",
    "prettier": "^3.8.1",
    "prisma": "^6.19.2",
    "serwist": "^9.5.13",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vinext": "1.3.0",
    "vite": "8.3.5",
    "wrangler": "4.151.3"
  },
  "type": "module"
}
