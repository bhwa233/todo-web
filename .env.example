# Gallery MCP is disabled when this is empty. Generate with openssl rand -hex 32.
GALLERY_MCP_TOKEN=
# Optional, comma-separated browser origins (non-browser clients may omit Origin).
GALLERY_MCP_ALLOWED_ORIGINS=https://own.bhwa233.com

# Server-side only. Never use NEXT_PUBLIC_ for the service token.
DATA_SERVICE_URL=http://localhost:8787
DATA_SERVICE_TOKEN=use-the-same-value-as-WEB_API_TOKEN
